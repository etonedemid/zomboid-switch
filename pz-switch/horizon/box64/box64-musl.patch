+/* pz-switch: generated code lives in a dual-mapped arena (Horizon code memory: the same pages at an RW address and at
+ * an RX address). Box64 writes through the RW view everywhere; only the addresses it jumps to are moved to the RX view,
+ * by box64_jit_delta (constant for the single arena). */
+intptr_t box64_jit_delta;
+void* lx_jit_reserve(size_t size, intptr_t* delta);   /* platform: returns the RW base of a size-byte arena */
+static uint8_t* jit_cur;
+static uint8_t* jit_end;
+static size_t jit_arena;
+static void* jit_mmap(size_t size)
+{
+    if(!jit_cur) {
+        // ponytail: one fixed arena, never returned (LX_JIT_MB, default 96); chain arenas if that proves too small
+        const char* mb = getenv("LX_JIT_MB");
+        jit_arena = (size_t)(mb ? atoi(mb) : 96) << 20;
+        jit_cur = lx_jit_reserve(jit_arena, &box64_jit_delta);
+        if(!jit_cur) return MAP_FAILED;
+        jit_end = jit_cur + jit_arena;
+    }
+    if(jit_cur + size > jit_end) return MAP_FAILED;
+    void* p = jit_cur;
+    jit_cur += size;
+    return p;
+}
