+        p = (uint8_t*)p - box64_jit_delta;   // pz-switch: native PCs are RX addresses, the maps hold RW ones
 
     mapchunk_t* bl = (mapchunk_t*)rb_get_64(rbt_dynmem, (uintptr_t)p);
     if(bl) {
@@ -896,7 +922,7 @@ uintptr_t AllocDynarecMap(size_t size)
             }
             #endif
             if(p==MAP_FAILED)
-                p = internal_mmap(NULL, allocsize, PROT_READ|PROT_WRITE|PROT_EXEC, MAP_ANONYMOUS|MAP_PRIVATE, -1, 0);
+                p = jit_mmap(allocsize);
             if(p==MAP_FAILED) {
