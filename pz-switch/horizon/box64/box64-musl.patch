 //EXPORT void my_pthread_exit(x64emu_t* emu, void* retval)
@@ -1242,3 +1242,22 @@ int checkUnlockMutex(void* m)
 	}
 	return 0;
 }
+
+/* pz-switch: on a musl host, x86 glibc's static mutex initializers don't mean the same thing (glibc keeps the kind at
+ * byte 16, musl the type at byte 0; the type numbers agree). Convert a still-pristine static initializer in place the
+ * first time the mutex is used. Dynamically initialised mutexes already use the host layout (my_pthread_mutex_init). */
+static void fix_static_mutex(pthread_mutex_t* m)
+{
+	int* w = (int*)m;
+	if(w[0]==0 && w[1]==0 && w[2]==0 && w[3]==0 && w[4]>0 && w[4]<4) {
+		__atomic_store_n(&w[0], w[4], __ATOMIC_RELAXED);
+		__atomic_store_n(&w[4], 0, __ATOMIC_RELEASE);
+	}
+}
+EXPORT int my_pthread_mutex_lock(x64emu_t* emu, pthread_mutex_t* m) { (void)emu; fix_static_mutex(m); return pthread_mutex_lock(m); }
+EXPORT int my_pthread_mutex_trylock(x64emu_t* emu, pthread_mutex_t* m) { (void)emu; fix_static_mutex(m); return pthread_mutex_trylock(m); }
+EXPORT int my_pthread_mutex_unlock(x64emu_t* emu, pthread_mutex_t* m) { (void)emu; fix_static_mutex(m); return pthread_mutex_unlock(m); }
+EXPORT int my_pthread_mutex_timedlock(x64emu_t* emu, pthread_mutex_t* m, void* t) { (void)emu; fix_static_mutex(m); return pthread_mutex_timedlock(m, t); }
+EXPORT int my___pthread_mutex_lock(x64emu_t* emu, pthread_mutex_t* m) __attribute__((alias("my_pthread_mutex_lock")));
+EXPORT int my___pthread_mutex_unlock(x64emu_t* emu, pthread_mutex_t* m) __attribute__((alias("my_pthread_mutex_unlock")));
+EXPORT int my___pthread_mutex_trylock(x64emu_t* emu, pthread_mutex_t* m) __attribute__((alias("my_pthread_mutex_trylock")));
