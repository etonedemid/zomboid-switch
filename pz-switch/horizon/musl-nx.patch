@@ -0,0 +1,7 @@
+/* pz-switch: a thread can't free the stack it is running on; the emulation layer frees it after switching away. */
+#include <stddef.h>
+_Noreturn void __lx_unmapself(void *, size_t);
+_Noreturn void __unmapself(void *base, size_t size)
+{
+	__lx_unmapself(base, size);
+}
