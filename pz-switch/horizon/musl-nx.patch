diff -ruN -x config.mak -x obj -x lib -x '*.o' -x '*.lo' -x '*.a' -x include/bits -x '*.specs' musl-1.2.5/src/thread/aarch64/syscall_cp.c musl-nx/src/thread/aarch64/syscall_cp.c
--- musl-1.2.5/src/thread/aarch64/syscall_cp.c	1969-12-31 21:00:00.000000000 -0300
+++ musl-nx/src/thread/aarch64/syscall_cp.c	2026-10-05 09:55:15.061652031 -0300
@@ -0,0 +1,12 @@
+/* pz-switch: cancellation is only honoured at entry (no async cancel without signals). */
+long __lx_syscall(long, long, long, long, long, long, long);
+long __cancel(void);
+long __syscall_cp_asm(volatile int *cancel, long n, long u, long v, long w, long x, long y, long z)
+{
+	if (*cancel) return __cancel();
+	return __lx_syscall(n, u, v, w, x, y, z);
+}
+
+/* labels pthread_cancel's signal handler compares the interrupted PC against; without signals it never runs */
+__asm__(".global __cp_begin\n.hidden __cp_begin\n.global __cp_end\n.hidden __cp_end\n.global __cp_cancel\n.hidden __cp_cancel\n"
+        ".text\n__cp_begin:\n__cp_end:\n__cp_cancel:\n  b __cancel\n");
