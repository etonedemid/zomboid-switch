diff -ruN -x config.mak -x obj -x lib -x '*.o' -x '*.lo' -x '*.a' -x include/bits -x '*.specs' musl-1.2.5/src/thread/aarch64/clone.c musl-nx/src/thread/aarch64/clone.c
--- musl-1.2.5/src/thread/aarch64/clone.c	1969-12-31 21:00:00.000000000 -0300
+++ musl-nx/src/thread/aarch64/clone.c	2026-10-05 08:36:43.024916897 -0300
@@ -0,0 +1,7 @@
+/* pz-switch: threads are libnx threads; the emulation layer runs fn(arg) on the given stack with tpidr_el0 = tls. */
+#include <sys/types.h>
+int __lx_clone(int (*)(void *), void *, int, void *, pid_t *, void *, pid_t *);
+int __clone(int (*fn)(void *), void *stack, int flags, void *arg, pid_t *ptid, void *tls, pid_t *ctid)
+{
+	return __lx_clone(fn, stack, flags, arg, ptid, tls, ctid);
+}
